<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tranal.Cli</RootNamespace>
    <!-- NU1510: o pacote do Event Log vem implicito; a referencia explicita
         e o que garante a compilacao do tipo EventRecord no nucleo compartilhado. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <AssemblyName>tranal</AssemblyName>
    <Version>1.4.0</Version>
    <Product>Tranal Uninstaller</Product>
  </PropertyGroup>

  <!-- Nucleo compartilhado com a aplicacao grafica (fonte compartilhada MSBuild). -->
  <ItemGroup>
    <Compile Include="..\Tranal.Uninstaller\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

  <!-- Catalogos de idioma: os mesmos arquivos embarcados na aplicacao grafica. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Tranal.Uninstaller\Lang\*.json" LinkBase="Lang" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!--
    O nucleo compartilhado usa o Windows Event Log (o Crash Analyzer).
    A CLI compila o Core, entao precisa da mesma referencia.
  -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <!-- A suite de testes precisa de alguns membros internos (redirecionar a
       pasta de backups e o arquivo de preferencias para um temporario, sem
       tocar no ambiente de quem roda os testes). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tranal.Tests" />
  </ItemGroup>
</Project>
