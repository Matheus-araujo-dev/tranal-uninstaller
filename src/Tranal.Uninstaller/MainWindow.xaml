        <Border x:Name="ContentHostBorder" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="8" Background="{DynamicResource PanelBrush}">
          <ContentControl x:Name="ContentHost" />
        </Border>
      </Grid>

      <!-- barra da selecao: o que vai ser desinstalado, e o botao que faz -->
      <Border Grid.Row="4" x:Name="SelectionBar" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource HoverBrush}" Margin="0,0,14,0">
            <Grid>
              <Image x:Name="SelectionIcon" Width="26" Height="26" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="SelectionGlyph" Style="{StaticResource GlyphStatic}" Text="&#xE71D;"
                         HorizontalAlignment="Center" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="SelectionTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TitleTextBrush}" Text="{loc:Tr Selection.None.Title}" />
            <TextBlock x:Name="SelectionDetail" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextDimBrush}" Text="{loc:Tr Selection.None.Hint}" />
          </StackPanel>
          <Button Grid.Column="2" x:Name="QuickUninstallButton" Style="{StaticResource OutlineButton}"
                  Content="{loc:Tr Action.QuickUninstall}" ToolTip="{loc:Tr Action.QuickUninstallTip}"
                  Margin="12,0,0,0" IsEnabled="False" Click="QuickUninstallButton_Click"
                  AutomationProperties.AutomationId="CmdQuickUninstallButton" />
          <Button Grid.Column="3" x:Name="UninstallButton" Style="{StaticResource PrimaryButton}"
                  ToolTip="{loc:Tr Action.UninstallTip}" Margin="10,0,0,0" IsEnabled="False"
                  Click="UninstallButton_Click" AutomationProperties.AutomationId="CmdUninstallButton">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Action.Uninstall}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- barra de status -->
      <Border Grid.Row="5" x:Name="StatusBarBorder" Padding="2,10,0,14">
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="ProgramStatusText" FontSize="11.5"
                   Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>

    <!--
      O painel lateral de configuracoes (item 52 do backlog): os filtros e os
      realces. Ele aparece a direita da lista e edita o mesmo conjunto de
      filtros que o popup e a caixa de busca.
    -->
    <Border Grid.Column="2" x:Name="SettingsPanelBorder" Visibility="Collapsed" Width="300"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
      <ui:SettingsSidebar x:Name="SettingsSidebarPanel" />
    </Border>

    <!--
      O painel ancorado (o "push pin" do Uninstall Tool): a ferramenta que o
      usuario fixou continua na lateral enquanto ele navega pelas outras.
    -->
    <Border Grid.Column="3" x:Name="DockPanelBorder" Visibility="Collapsed" Width="340"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" x:Name="DockPanelHeaderBorder" Padding="16,14,8,10">
          <Grid>
            <TextBlock x:Name="DockPanelTitle" VerticalAlignment="Center" FontSize="14"
                       FontWeight="SemiBold" Foreground="{DynamicResource TitleTextBrush}" />
            <Button x:Name="DockPanelCloseButton" Content="&#xE711;" Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right" Width="30" Height="30" FontSize="11"
                    Click="DockPanelCloseButton_Click"
                    AutomationProperties.AutomationId="CmdDockPanelClose"
                    ToolTip="{loc:Tr Panel.Undock}" />
          </Grid>
        </Border>
        <ContentControl Grid.Row="1" x:Name="DockPanelHost" Margin="8,0,8,8" />
      </Grid>
    </Border>
  </Grid>
</Window>
