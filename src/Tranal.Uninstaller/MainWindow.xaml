<Window x:Class="Tranal.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        xmlns:ui="clr-namespace:Tranal.Uninstaller.Ui.Appearance"
        Title="Tranal Uninstaller Pro" Height="820" Width="1320" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <!--
    A janela principal no estilo do Tranal Sentinel.

    A ideia da tela: a tarefa principal (desinstalar) fica na frente, sozinha.
    Uma lista limpa, uma busca grande e um botao "Desinstalar" que diz o que
    vai acontecer. Todo o resto mora em "Ferramentas", cada uma com o guia
    "o que faz / o que voce ganha / quando usar / cuidado" — a pessoa le
    antes de mexer.
  -->

  <Window.Resources>
    <!--
      O template da coluna do nome: icone e nome.
      A grade da lista e montada em codigo (o usuario escolhe quais colunas
      quer ver), mas o template continua aqui: um DataTemplate escrito em
      codigo e ilegivel.
    -->
    <DataTemplate x:Key="ProgramNameTemplate">
      <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center"
                Background="{DynamicResource CardBrush}">
          <Grid>
            <!-- Sem icone, o desenho generico de aplicativo: a linha nunca fica com um buraco. -->
            <TextBlock Text="&#xE71D;" FontSize="13" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStatic}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>
        <!--
          O realce pinta o nome. Sem regra que case, o pincel e nulo e o nome
          usa a cor do tema.
        -->
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{Binding HighlightTextBrush}" />
              <Style.Triggers>
                <!-- Sem realce o pincel e nulo: o nome usa a cor do tema. -->
                <DataTrigger Binding="{Binding HighlightColorKey}" Value="">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!--
      A coluna das caixas de selecao: e a "Show check boxes in Details view"
      do Revo (15334). Fica a esquerda de tudo e so aparece na visualizacao
      de detalhes. Desligada por padrao desde a interface nova.
    -->
    <DataTemplate x:Key="ProgramCheckTemplate">
      <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                HorizontalAlignment="Center" />
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{DynamicResource PanelBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- ================= NAVEGACAO LATERAL ================= -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- marca -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,22">
          <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource PrimaryBrush}">
            <TextBlock Style="{StaticResource GlyphStatic}" Text="&#xE74D;" FontSize="16"
                       HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Tranal" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TitleTextBrush}" />
            <TextBlock Text="Uninstaller Pro" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- rodape: apoio e opcoes -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,16">
          <Button Style="{StaticResource ModuleButton}" Tag="Donate" Click="Doar_Click"
                  AutomationProperties.AutomationId="CmdDonate">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" Margin="0,0,12,0" />
              <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Cmd.Donate}" />
            </StackPanel>
          </Button>
          <Button x:Name="OptionsNavButton" Style="{StaticResource ModuleButton}" Click="OptionsNavButton_Click"
                  AutomationProperties.AutomationId="NavOptions">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,12,0" />
              <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.Options}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SidebarNav">
            <!-- O que a pessoa veio fazer: remover programas. -->
            <StackPanel x:Name="ModulePanel">
              <Button x:Name="BtnAllPrograms" Style="{StaticResource ModuleButtonSelected}" Tag="AllPrograms"
                      Click="ModuleButton_Click" AutomationProperties.AutomationId="ModuleAllPrograms">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.Programs}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="WindowsApps" Click="ModuleButton_Click"
                      AutomationProperties.AutomationId="ModuleWindowsApps">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.WindowsApps}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="BrowserExtensions" Click="ModuleButton_Click"
                      AutomationProperties.AutomationId="ModuleBrowserExtensions">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xEA86;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.Extensions}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="UninstallHistory" Click="ToolButton_Click"
                      AutomationProperties.AutomationId="NavHistory">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.History}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- As ferramentas: tudo o que nao e desinstalar, em uma pagina so. -->
            <Border x:Name="ToolsToolbarHeaderBorder" Margin="0,6,0,0">
              <Button x:Name="BtnToolsHome" Style="{StaticResource ModuleButton}" Tag="ToolsHome"
                      Click="ModuleButton_Click" AutomationProperties.AutomationId="ModuleToolsHome">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE90F;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.Tools}" />
                </StackPanel>
              </Button>
            </Border>

            <!-- Outras formas de remover: para quando a lista nao basta. -->
            <TextBlock Text="{loc:Tr Nav.More}" Style="{StaticResource SectionLabel}" Margin="24,22,0,6" FontSize="10.5" />
            <StackPanel x:Name="MorePanel">
              <Button x:Name="ForcedUninstallButton" Style="{StaticResource ModuleButton}"
                      Click="ForcedUninstallButton_Click" ToolTip="{loc:Tr Nav.ForcedTip}"
                      AutomationProperties.AutomationId="CmdForcedUninstall">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Nav.Forced}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="TracedPrograms" Click="ModuleButton_Click"
                      AutomationProperties.AutomationId="ModuleTracedPrograms">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Module.TracedPrograms}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="LogsDatabase" Click="ModuleButton_Click"
                      AutomationProperties.AutomationId="ModuleLogsDatabase">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F1;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Module.LogsDatabase}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModuleButton}" Tag="HunterMode" Click="ModuleButton_Click"
                      AutomationProperties.AutomationId="ModuleHunterMode">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Module.HunterMode}" />
                </StackPanel>
              </Button>
              <!--
                A Central: o que precisa de atencao na maquina, em um lugar so.
                E o "Action Center" do IObit (medido no binario dele), sem a
                propaganda de produtos: aqui cada item leva a ferramenta do
                Tranal que age sobre ele.
              -->
              <Button x:Name="BtnCentral" Style="{StaticResource ModuleButton}" Tag="Central"
                      Click="ModuleButton_Click" AutomationProperties.AutomationId="ModuleCentral">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,12,0" />
                  <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Module.Central}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ================= AREA PRINCIPAL ================= -->
    <Grid Grid.Column="1" Margin="32,0,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />  <!-- cabecalho -->
        <RowDefinition Height="Auto" />  <!-- busca e acoes -->
        <RowDefinition Height="Auto" />  <!-- guia da ferramenta -->
        <RowDefinition Height="*" />     <!-- conteudo -->
        <RowDefinition Height="Auto" />  <!-- barra da selecao -->
        <RowDefinition Height="Auto" />  <!-- status -->
      </Grid.RowDefinitions>

      <!-- cabecalho: titulo, explicacao e o menu -->
      <Border Grid.Row="0" x:Name="MainToolbarBorder" Padding="0,26,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Button x:Name="BackToToolsButton" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                    Margin="0,0,0,6" HorizontalAlignment="Left" Click="BackToToolsButton_Click"
                    AutomationProperties.AutomationId="CmdBackToTools">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="11" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Guide.Back}" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="ModuleHeader" Style="{StaticResource PageTitle}" Text="{loc:Tr Module.AllPrograms}"
                       Foreground="{DynamicResource TitleTextBrush}" />
            <Border x:Name="DescriptionPanelBorder">
              <TextBlock x:Name="DescriptionText" Style="{StaticResource PageSubtitle}" MaxWidth="760"
                         HorizontalAlignment="Left" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <!--
              O painel lateral de configuracoes (o "Properties Sidebar" do BCU):
              filtros e realces. A regra mora no nucleo; o painel so edita o
              estado.
            -->
            <Button x:Name="SettingsPanelButton" Content="&#xE71C;" Style="{StaticResource IconButton}"
                    Click="SettingsPanelButton_Click" AutomationProperties.AutomationId="CmdSettingsPanel"
                    ToolTip="{loc:Tr Action.Panel}" />
            <!--
              O painel ancorado: a ferramenta que o usuario fixou. O painel
              continua na lateral quando o usuario troca de tela.
            -->
            <Button x:Name="DockPanelButton" Content="&#xE718;" Style="{StaticResource IconButton}"
                    Click="DockPanelButton_Click" AutomationProperties.AutomationId="CmdDockPanel"
                    ToolTip="{loc:Tr Panel.Dock}" Visibility="Collapsed" />
            <Button x:Name="MainMenuButton" Content="&#xE700;" Style="{StaticResource IconButton}"
                    Click="MainMenuButton_Click" AutomationProperties.AutomationId="CmdMainMenu"
                    ToolTip="{loc:Tr Nav.Menu}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- busca e acoes da lista de programas -->
      <Grid Grid.Row="1" x:Name="ProgramsToolbar" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="560" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="SearchBox" Height="40" Padding="38,0,12,0" FontSize="13" VerticalContentAlignment="Center"
                   TextChanged="SearchBox_TextChanged" AutomationProperties.AutomationId="SearchBox"
                   AutomationProperties.Name="{loc:Tr Search.Placeholder}" />
          <TextBlock Style="{StaticResource GlyphStatic}" Text="&#xE721;" FontSize="13" Margin="14,0,0,0"
                     HorizontalAlignment="Left" IsHitTestVisible="False" />
          <TextBlock x:Name="SearchPlaceholder" Text="{loc:Tr Search.Placeholder}" Margin="39,0,0,0" FontSize="13"
                     VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource FaintTextBrush}" />
        </Grid>
        <Button Grid.Column="1" x:Name="FilterButton" Style="{StaticResource OutlineButton}" Margin="10,0,0,0"
                Height="40" Click="FilterButton_Click" AutomationProperties.AutomationId="CmdFilters"
                ToolTip="{loc:Tr Sidebar.Filters}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="12" Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Action.Filters}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" x:Name="MoreCommandsButton" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                Height="40" Click="MoreCommandsButton_Click" AutomationProperties.AutomationId="CmdMoreCommands">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource BtnText}" Text="{loc:Tr Action.More}" />
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- popup de filtros -->
      <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}"
             Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16,12" MinWidth="260">
          <StackPanel>
            <TextBlock Text="{loc:Tr Sidebar.FilterByType}" Style="{StaticResource SectionLabel}" Margin="0,2,0,6" />
            <RadioButton x:Name="TypeAllRadio" Content="{loc:Tr Sidebar.All}" IsChecked="True" Margin="0,0,0,6"
                         Tag="All" Checked="FilterOption_Changed" />
            <RadioButton x:Name="Type32Radio" Content="{loc:Tr Sidebar.Bits32}" Margin="0,0,0,6"
                         Tag="32" Checked="FilterOption_Changed" />
            <RadioButton x:Name="Type64Radio" Content="{loc:Tr Sidebar.Bits64}" Margin="0,0,0,6"
                         Tag="64" Checked="FilterOption_Changed" />
            <RadioButton x:Name="TypeMsiRadio" Content="{loc:Tr Sidebar.Msi}" Margin="0,0,0,6"
                         Tag="msi" Checked="FilterOption_Changed" />

            <TextBlock Text="{loc:Tr Sidebar.FilterBySize}" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
            <RadioButton x:Name="SizeAllRadio" Content="{loc:Tr Sidebar.All}" IsChecked="True" Margin="0,0,0,6"
                         Tag="all" Checked="FilterOption_Changed" />
            <RadioButton x:Name="SizeSmallRadio" Content="{loc:Tr Sidebar.SizeSmall}" Margin="0,0,0,6"
                         Tag="small" Checked="FilterOption_Changed" />
            <RadioButton x:Name="SizeMediumRadio" Content="{loc:Tr Sidebar.SizeMedium}" Margin="0,0,0,6"
                         Tag="medium" Checked="FilterOption_Changed" />
            <RadioButton x:Name="SizeLargeRadio" Content="{loc:Tr Sidebar.SizeLarge}" Margin="0,0,0,6"
                         Tag="large" Checked="FilterOption_Changed" />

            <TextBlock Text="{loc:Tr Sidebar.FilterByDrive}" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
            <StackPanel x:Name="DriveFilterPanel" />

            <!--
              "Hidden" (15362) do Revo: mostra os componentes que o Windows
              esconde por padrao. E a mesma preferencia de "Mostrar
              componentes do sistema" das Opcoes — uma regra, dois lugares
              para chegar nela.
            -->
            <TextBlock Text="{loc:Tr Sidebar.FilterByHidden}" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
            <CheckBox x:Name="HiddenFilterCheck" Content="{loc:Tr Sidebar.Hidden}" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="FilterHidden"
                      Checked="HiddenFilter_Changed" Unchecked="HiddenFilter_Changed" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- guia da ferramenta aberta: o que faz, o que ganha, quando usar, cuidado -->
      <Border Grid.Row="2" x:Name="ToolGuidePanel" Style="{StaticResource Card}" Padding="18,14"
              Margin="0,0,0,14" Visibility="Collapsed">
        <DockPanel>
          <Grid DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource GlyphStatic}" Text="&#xE946;" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Guide.Show}" FontWeight="SemiBold" VerticalAlignment="Center"
                         Foreground="{DynamicResource TitleTextBrush}" />
            </StackPanel>
            <Button x:Name="GuideToggleButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                    Click="GuideToggleButton_Click" AutomationProperties.AutomationId="CmdGuideToggle">
              <TextBlock x:Name="GuideToggleText" Style="{StaticResource BtnText}" Text="{loc:Tr Guide.Hide}" />
            </Button>
          </Grid>
          <UniformGrid x:Name="GuideBody" Columns="4" Margin="0,12,0,0">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Guide.Label.What}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
              <TextBlock x:Name="GuideWhat" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="18" />
            </StackPanel>
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Guide.Label.Gain}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
              <TextBlock x:Name="GuideGain" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="18" />
            </StackPanel>
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Guide.Label.When}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
              <TextBlock x:Name="GuideWhen" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="18" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{loc:Tr Guide.Label.Avoid}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
              <TextBlock x:Name="GuideAvoid" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" LineHeight="18" />
            </StackPanel>
          </UniformGrid>
        </DockPanel>
      </Border>

      <!-- conteudo: lista de programas, pagina de ferramentas OU a tela aberta -->
      <Grid Grid.Row="3">
        <!-- Programas instalados -->
        <Border x:Name="ProgramsView" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="6,4" Background="{DynamicResource PanelBrush}">
          <ListView x:Name="ProgramsList" BorderThickness="0"
                    AutomationProperties.AutomationId="ProgramsList"
                    Background="Transparent"
                    SelectionMode="Extended"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    PreviewMouseRightButtonDown="ProgramsList_PreviewMouseRightButtonDown"
                    MouseDoubleClick="ProgramsList_MouseDoubleClick"
                    SelectionChanged="ProgramsList_SelectionChanged">
            <!--
              A grade (ListView.View) e montada em codigo: o usuario escolhe
              quais colunas quer ver (o "Columns" do Revo, 15054) e o XAML
              seria uma segunda copia do catalogo de colunas.
            -->
            <ListView.ContextMenu>
              <ContextMenu x:Name="ProgramContextMenu" Opened="ProgramContextMenu_Opened" />
            </ListView.ContextMenu>

            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10,14,0,6">
                      <TextBlock FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}"
                                 Text="{Binding Name, Mode=OneWay}" />
                      <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="8" Background="{DynamicResource CardBrush}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                   Text="{Binding ItemCount, Mode=OneWay}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
          </ListView>
        </Border>

        <!--
          Ferramentas: a pagina de cartoes. Os botoes ficam todos aqui (um por
          ferramenta do catalogo, ToolCatalog). A janela os distribui nas
          categorias do nucleo (Core/ToolGuide.cs) e preenche o cartao com o
          icone, o nome e o "o que faz" — o agrupamento mora em um lugar so.
        -->
        <ScrollViewer x:Name="ToolsHomeView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel>
            <StackPanel x:Name="ToolSections" />
            <StackPanel x:Name="ToolPanel" Visibility="Collapsed">
              <Button Style="{StaticResource ToolCard}" Tag="AutorunManager" Click="ToolButton_Click" Content="{loc:Tr Module.AutorunManager}"
                      AutomationProperties.AutomationId="ToolAutorunManager" />
              <Button Style="{StaticResource ToolCard}" Tag="BootCenter" Click="ToolButton_Click" Content="{loc:Tr Module.BootCenter}"
                      AutomationProperties.AutomationId="ToolBootCenter" />
              <Button Style="{StaticResource ToolCard}" Tag="ActiveFiles" Click="ToolButton_Click" Content="{loc:Tr Module.ActiveFiles}"
                      AutomationProperties.AutomationId="ToolActiveFiles" />
              <Button Style="{StaticResource ToolCard}" Tag="FileAssociator" Click="ToolButton_Click" Content="{loc:Tr Module.FileAssociator}"
                      AutomationProperties.AutomationId="ToolFileAssociator" />
              <Button Style="{StaticResource ToolCard}" Tag="UndoCenter" Click="ToolButton_Click" Content="{loc:Tr Module.UndoCenter}"
                      AutomationProperties.AutomationId="ToolUndoCenter" />
              <Button Style="{StaticResource ToolCard}" Tag="FileOwnership" Click="ToolButton_Click" Content="{loc:Tr Module.FileOwnership}"
                      AutomationProperties.AutomationId="ToolFileOwnership" />
              <Button Style="{StaticResource ToolCard}" Tag="DeepAnalysis" Click="ToolButton_Click" Content="{loc:Tr Module.DeepAnalysis}"
                      AutomationProperties.AutomationId="ToolDeepAnalysis" />
              <Button Style="{StaticResource ToolCard}" Tag="InstallerGuard" Click="ToolButton_Click" Content="{loc:Tr Module.InstallerGuard}"
                      AutomationProperties.AutomationId="ToolInstallerGuard" />
              <Button Style="{StaticResource ToolCard}" Tag="FailedUninstalls" Click="ToolButton_Click" Content="{loc:Tr Module.FailedUninstalls}"
                      AutomationProperties.AutomationId="ToolFailedUninstalls" />
              <Button Style="{StaticResource ToolCard}" Tag="PowerPlan" Click="ToolButton_Click" Content="{loc:Tr Module.PowerPlan}"
                      AutomationProperties.AutomationId="ToolPowerPlan" />
              <Button Style="{StaticResource ToolCard}" Tag="Hibernation" Click="ToolButton_Click" Content="{loc:Tr Module.Hibernation}"
                      AutomationProperties.AutomationId="ToolHibernation" />
              <Button Style="{StaticResource ToolCard}" Tag="StoreStartup" Click="ToolButton_Click" Content="{loc:Tr Module.StoreStartup}"
                      AutomationProperties.AutomationId="ToolStoreStartup" />
              <Button Style="{StaticResource ToolCard}" Tag="MsiDependencies" Click="ToolButton_Click" Content="{loc:Tr Module.MsiDependencies}"
                      AutomationProperties.AutomationId="ToolMsiDependencies" />
              <Button Style="{StaticResource ToolCard}" Tag="AppxCatalog" Click="ToolButton_Click" Content="{loc:Tr Module.AppxCatalog}"
                      AutomationProperties.AutomationId="ToolAppxCatalog" />
              <Button Style="{StaticResource ToolCard}" Tag="SystemDlls" Click="ToolButton_Click" Content="{loc:Tr Module.SystemDlls}"
                      AutomationProperties.AutomationId="ToolSystemDlls" />
              <Button Style="{StaticResource ToolCard}" Tag="TrayIcon" Click="ToolButton_Click" Content="{loc:Tr Module.TrayIcon}"
