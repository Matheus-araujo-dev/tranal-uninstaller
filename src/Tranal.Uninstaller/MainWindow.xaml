<Window x:Class="Tranal.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Tranal Uninstaller Pro" Height="900" Width="1600" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource PanelBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="12"
        UseLayoutRounding="True">

  <Window.Resources>
    <!--
      O template da coluna do nome: caixa de marcacao, icone e nome.
      A grade da lista e montada em codigo (o usuario escolhe quais colunas
      quer ver), mas o template continua aqui: um DataTemplate escrito em
      codigo e ilegivel.
    -->
    <DataTemplate x:Key="ProgramNameTemplate">
      <StackPanel Orientation="Horizontal">
        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                  Margin="0,0,6,0" />
        <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
               VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= BARRA LATERAL ================= -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />   <!-- aba -->
          <RowDefinition Height="38" />   <!-- busca -->
          <RowDefinition Height="44" />   <!-- titulo -->
          <RowDefinition Height="52" />   <!-- botoes -->
          <RowDefinition Height="46" />   <!-- instalar com -->
          <RowDefinition Height="*" />    <!-- modulos -->
          <RowDefinition Height="Auto" /> <!-- cabecalho ferramentas -->
          <RowDefinition Height="Auto" /> <!-- ferramentas -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr Sidebar.Uninstaller}" Margin="10,0"
                   VerticalAlignment="Center" FontWeight="Bold" FontSize="13" />

        <!-- busca + botao de filtro -->
        <Grid Grid.Row="1" Margin="8,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Grid.Column="0" VerticalContentAlignment="Center"
                   TextChanged="SearchBox_TextChanged" />
          <TextBlock Text="&#x1F50D;" HorizontalAlignment="Left" Margin="4,0,0,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" IsHitTestVisible="False" />
          <TextBlock Text="&#x1F4CC;" HorizontalAlignment="Right" Margin="0,0,6,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" IsHitTestVisible="False" />
          <Button Grid.Column="1" x:Name="FilterButton" Content="&#x25BE;" Width="26"
                  Margin="4,0,0,0" Style="{StaticResource FlatButton}" Padding="0"
                  Click="FilterButton_Click" ToolTip="{loc:Tr Sidebar.Filters}" />
        </Grid>

        <!-- popup de filtros -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}"
               Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
          <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                  BorderThickness="1" Padding="6" MinWidth="220">
            <StackPanel>
              <TextBlock Text="{loc:Tr Sidebar.FilterByType}" FontWeight="SemiBold" Margin="4,2" />
              <RadioButton x:Name="TypeAllRadio" Content="{loc:Tr Sidebar.All}" IsChecked="True" Margin="8,0,0,2"
                           Tag="All" Checked="FilterOption_Changed" />
              <RadioButton x:Name="Type32Radio" Content="{loc:Tr Sidebar.Bits32}" Margin="8,0,0,2"
                           Tag="32" Checked="FilterOption_Changed" />
              <RadioButton x:Name="Type64Radio" Content="{loc:Tr Sidebar.Bits64}" Margin="8,0,0,2"
                           Tag="64" Checked="FilterOption_Changed" />
              <RadioButton x:Name="TypeMsiRadio" Content="{loc:Tr Sidebar.Msi}" Margin="8,0,0,6"
                           Tag="msi" Checked="FilterOption_Changed" />

              <TextBlock Text="{loc:Tr Sidebar.FilterBySize}" FontWeight="SemiBold" Margin="4,2" />
              <RadioButton x:Name="SizeAllRadio" Content="{loc:Tr Sidebar.All}" IsChecked="True" Margin="8,0,0,2"
                           Tag="all" Checked="FilterOption_Changed" />
              <RadioButton x:Name="SizeSmallRadio" Content="{loc:Tr Sidebar.SizeSmall}" Margin="8,0,0,2"
                           Tag="small" Checked="FilterOption_Changed" />
              <RadioButton x:Name="SizeMediumRadio" Content="{loc:Tr Sidebar.SizeMedium}" Margin="8,0,0,2"
                           Tag="medium" Checked="FilterOption_Changed" />
              <RadioButton x:Name="SizeLargeRadio" Content="{loc:Tr Sidebar.SizeLarge}" Margin="8,0,0,8"
                           Tag="large" Checked="FilterOption_Changed" />

              <TextBlock Text="{loc:Tr Sidebar.FilterByDrive}" FontWeight="SemiBold" Margin="4,2" />
              <StackPanel x:Name="DriveFilterPanel" Margin="8,0,0,4" />

              <!--
                "Hidden" (15362) do Revo: mostra os componentes que o Windows
                esconde por padrao. E a mesma preferencia de "Mostrar
                componentes do sistema" das Opcoes — uma regra, dois lugares
                para chegar nela.
              -->
              <TextBlock Text="{loc:Tr Sidebar.FilterByHidden}" FontWeight="SemiBold" Margin="4,6,0,2" />
              <CheckBox x:Name="HiddenFilterCheck" Content="{loc:Tr Sidebar.Hidden}" Margin="8,0,0,4"
                        AutomationProperties.AutomationId="FilterHidden"
                        Checked="HiddenFilter_Changed" Unchecked="HiddenFilter_Changed" />
            </StackPanel>
          </Border>
        </Popup>

        <!-- titulo da acao -->
        <TextBlock Grid.Row="2" x:Name="ActionTitleText" Text="{loc:Tr Sidebar.Uninstall}" Margin="12,0"
                   VerticalAlignment="Center" FontSize="19" FontWeight="Bold"
                   Foreground="{DynamicResource TitleTextBrush}" />

        <!-- acoes principais -->
        <Grid Grid.Row="3" Margin="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="ForcedUninstallButton"
                  Style="{StaticResource FlatButton}" Margin="0,0,4,0"
                  Content="{loc:Tr Sidebar.ForcedUninstall}" Click="ForcedUninstallButton_Click" />
          <Button Grid.Column="1" x:Name="MoreCommandsButton"
                  Style="{StaticResource FlatButton}" Margin="4,0,0,0"
                  Content="{loc:Tr Sidebar.MoreCommands}" Click="MoreCommandsButton_Click" />
        </Grid>

        <TextBlock Grid.Row="4" Margin="12,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                   Text="{loc:Tr Sidebar.InstallWith}" />

        <!-- lista de modulos -->
        <StackPanel Grid.Row="5" x:Name="ModulePanel">
          <Button x:Name="BtnAllPrograms" Style="{StaticResource ModuleButtonSelected}" Tag="AllPrograms"
                  Click="ModuleButton_Click" AutomationProperties.AutomationId="ModuleAllPrograms">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F4D6;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.AllPrograms}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="TracedPrograms" Click="ModuleButton_Click"
                  AutomationProperties.AutomationId="ModuleTracedPrograms">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F4C8;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.TracedPrograms}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="WindowsApps" Click="ModuleButton_Click"
                  AutomationProperties.AutomationId="ModuleWindowsApps">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5A5;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.WindowsApps}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="BrowserExtensions" Click="ModuleButton_Click"
                  AutomationProperties.AutomationId="ModuleBrowserExtensions">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F310;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.BrowserExtensions}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="LogsDatabase" Click="ModuleButton_Click"
                  AutomationProperties.AutomationId="ModuleLogsDatabase">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5C2;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.LogsDatabase}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="HunterMode" Click="ModuleButton_Click"
                  AutomationProperties.AutomationId="ModuleHunterMode">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F3AF;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.HunterMode}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- cabecalho do grupo de ferramentas -->
        <Border Grid.Row="6" x:Name="ToolsToolbarHeaderBorder" MinHeight="24"
                Background="{DynamicResource ToolBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <TextBlock Text="{loc:Tr Sidebar.Tools}" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Border>

        <!-- ferramentas -->
        <StackPanel Grid.Row="7" x:Name="ToolPanel">
          <Button Style="{StaticResource ModuleButton}" Tag="AutorunManager" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolAutorunManager">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2699;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.AutorunManager}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="JunkCleaner" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolJunkCleaner">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5D1;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.JunkCleaner}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="WindowsTools" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolWindowsTools">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F527;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.WindowsTools}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="EvidenceRemover" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolEvidenceRemover">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F52B;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.EvidenceRemover}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="UnrecoverableDelete" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolUnrecoverableDelete">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5D1;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.UnrecoverableDelete}" />
            </StackPanel>
          </Button>

          <!-- Tracks Cleaner: os tres modulos separados, como no Revo -->
          <TextBlock Text="{loc:Tr Sidebar.GroupTracksCleaner}" Margin="10,10,0,2"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TextDimBrush}" />
          <Button Style="{StaticResource ModuleButton}" Tag="HistoryCleaner" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolHistoryCleaner">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5D0;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.HistoryCleaner}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="TracksBrowsers" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolTracksBrowsers">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F310;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.TracksBrowsers}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="TracksOffice" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolTracksOffice">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F4C4;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.TracksOffice}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ModuleButton}" Tag="TracksWindows" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolTracksWindows">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1FA9F;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.TracksWindows}" />
            </StackPanel>
          </Button>

          <!-- Otimizacao -->
          <TextBlock Text="{loc:Tr Sidebar.GroupOptimization}" Margin="10,10,0,2"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TextDimBrush}" />
          <Button Style="{StaticResource ModuleButton}" Tag="RegistryOptimizer" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolRegistryOptimizer">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F5C3;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.RegistryOptimizer}" />
            </StackPanel>
          </Button>

          <!-- Gestao do sistema: permissoes, servicos, tarefas, drivers, saude. -->
          <TextBlock Text="{loc:Tr Sidebar.GroupSystem}" Margin="10,10,0,2"
                     FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource TextDimBrush}" />
          <Button Style="{StaticResource ModuleButton}" Tag="SystemManagement" Click="ToolButton_Click"
                  AutomationProperties.AutomationId="ToolSystemManagement">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x1F6E0;" Margin="0,0,8,0" />
              <TextBlock Text="{loc:Tr Module.SystemManagement}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= AREA PRINCIPAL ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- cabecalho do modulo + botao de menu -->
      <Border Grid.Row="0" x:Name="MainToolbarBorder" MinHeight="30" Background="{DynamicResource HeaderBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ModuleHeader" Text="{loc:Tr Module.AllPrograms}" Margin="8,0"
                     VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource TitleTextBrush}" />
          <Button Grid.Column="1" x:Name="MainMenuButton" Content="&#x2630;" Width="34"
                  Style="{StaticResource FlatButton}" Margin="0,2,4,2" Padding="0"
                  Click="MainMenuButton_Click" AutomationProperties.AutomationId="CmdMainMenu"
                  ToolTip="Menu" />
        </Grid>
      </Border>

      <!-- conteudo: lista de programas OU painel do modulo/ferramenta -->
      <Grid Grid.Row="1">
        <!-- Todos os Programas -->
        <Grid x:Name="ProgramsView">
          <ListView x:Name="ProgramsList" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}"
                    AlternationCount="2"
                    SelectionMode="Extended"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    PreviewMouseRightButtonDown="ProgramsList_PreviewMouseRightButtonDown">
            <!--
              A grade (ListView.View) e montada em codigo: o usuario escolhe
              quais colunas quer ver (o "Columns" do Revo, 15054) e o XAML
              seria uma segunda copia do catalogo de colunas.
            -->
            <ListView.ContextMenu>
              <ContextMenu x:Name="ProgramContextMenu" Opened="ProgramContextMenu_Opened" />
            </ListView.ContextMenu>

            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource GroupHeaderBrush}" Padding="4,3">
                      <TextBlock FontWeight="Bold" Foreground="{DynamicResource TitleTextBrush}" FontSize="11">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding ItemCount, Mode=OneWay}" />
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
          </ListView>
        </Grid>

        <!-- painel do modulo/ferramenta ativo -->
        <ContentControl x:Name="ContentHost" Visibility="Collapsed" />
      </Grid>

      <!-- painel de descricao -->
      <Border Grid.Row="2" x:Name="DescriptionPanelBorder" Background="{DynamicResource DescriptionBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="22">
            <TextBlock Text="{loc:Tr Common.Description}" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
              <Button Content="&#x1F4CC;" Width="24" Height="18" Style="{StaticResource FlatButton}"
                      BorderThickness="0" Background="Transparent" ToolTip="Ocultar automaticamente" />
              <Button Content="&#x2715;" Width="24" Height="18" Style="{StaticResource FlatButton}"
                      BorderThickness="0" Background="Transparent" ToolTip="Fechar" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="DescriptionText" Margin="8,2,8,6" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextBrush}" FontSize="11" />
        </DockPanel>
      </Border>

      <!-- barra de status -->
      <Border Grid.Row="3" x:Name="StatusBarBorder" MinHeight="24" Background="{DynamicResource StatusBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <TextBlock x:Name="StatusText" Margin="8,0" VerticalAlignment="Center" FontSize="11" />
      </Border>
    </Grid>
  </Grid>
</Window>
