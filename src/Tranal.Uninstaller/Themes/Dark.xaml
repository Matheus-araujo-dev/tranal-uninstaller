<!--
  Tema unico do Tranal Uninstaller Pro — monocromatico escuro.
  Inspirado na paleta do Tranal Sentinel: preto puro como base,
  superficies em cinza muito escuro, texto claro, sem cor cromatica.

  Este dicionario contem SOMENTE brushes: os estilos ficam em Styles.xaml.
  A troca em runtime e so uma escrita de brushes em Application.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Superficies ===== -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF080808" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FF0E0E0E" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FF080808" />
  <SolidColorBrush x:Key="DescriptionBrush" Color="#FF0E0E0E" />
  <SolidColorBrush x:Key="ToolBarBrush" Color="#FF080808" />
  <SolidColorBrush x:Key="StatusBarBrush" Color="#FF080808" />
  <SolidColorBrush x:Key="GroupHeaderBrush" Color="#FF121212" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FF0E0E0E" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#FF121212" />

  <!-- ===== Texto ===== -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#FF8C8C8C" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FF4A4A4A" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FFF5F5F5" />

  <!-- ===== Contorno e interacao ===== -->
  <SolidColorBrush x:Key="BorderBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF181818" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FF252525" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFF5F5F5" />

  <!-- ===== Controles ===== -->
  <SolidColorBrush x:Key="ButtonFaceBrush" Color="#FF181818" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF252525" />
  <SolidColorBrush x:Key="InputBrush" Color="#FF0E0E0E" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#FF080808" />
  <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FF1F1F1F" />

  <!-- ===== Semanticos ===== -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FFCC5555" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF66CC66" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFFFCC55" />

</ResourceDictionary>
