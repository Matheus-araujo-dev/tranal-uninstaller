<!--
  Cores do tema escuro do Tranal Uninstaller Pro.
  Medidas nas capturas reais do Revo Uninstaller Pro 5.5.4 (UI dark).

  Este dicionario contem SOMENTE brushes: os estilos ficam em Styles.xaml e
  sao comuns aos dois temas. Assim a troca de tema em runtime e so uma troca
  de brushes em Application.Resources — nenhum dicionario XAML precisa ser
  carregado em runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Superficies ===== -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF464646" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FF525252" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FF3C3C3C" />
  <SolidColorBrush x:Key="DescriptionBrush" Color="#FF4C4C4C" />
  <SolidColorBrush x:Key="ToolBarBrush" Color="#FF3E3E3E" />
  <SolidColorBrush x:Key="StatusBarBrush" Color="#FF3C3C3C" />
  <SolidColorBrush x:Key="GroupHeaderBrush" Color="#FF464646" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#FF5A5A5A" />

  <!-- ===== Texto ===== -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFE6E6E6" />
  <!-- Titulos sobre superficies neutras (sidebar, cabecalhos). No tema escuro
       o Revo usa branco puro; no claro precisa de tinta escura. -->
  <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#FFB4B4B4" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FF7A7A7A" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FF3399FF" />

  <!-- ===== Contorno e interacao ===== -->
  <SolidColorBrush x:Key="BorderBrush" Color="#FF2E2E2E" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF2A2A2A" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF2F6FB5" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF3399FF" />

  <!-- ===== Controles ===== -->
  <SolidColorBrush x:Key="ButtonFaceBrush" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF6A6A6A" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF6E6E6E" />
  <SolidColorBrush x:Key="InputBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="#FF2A2A2A" />
  <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#FF3F3F3F" />
  <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#FFEFEFEF" />
  <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FF2C2C2C" />

  <!-- ===== Semanticos ===== -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FFCC5555" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF66CC66" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFFFCC55" />

</ResourceDictionary>
