<!--
  Cores do tema ardosia: o escuro do Sentinel com um tom frio de azul-grafite.
  Mesmas chaves dos outros temas.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Superficies ===== -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF0F151C" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="DescriptionBrush" Color="#FF141C25" />
  <SolidColorBrush x:Key="ToolBarBrush" Color="#FF0F151C" />
  <SolidColorBrush x:Key="StatusBarBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="GroupHeaderBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FF141C25" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="CardBrush" Color="#FF141C25" />

  <!-- ===== Texto ===== -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFE8EEF5" />
  <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#FF8A9BB0" />
  <SolidColorBrush x:Key="FaintTextBrush" Color="#FF56667A" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FF44526A" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FF8FC4F0" />

  <!-- ===== Contorno e interacao ===== -->
  <SolidColorBrush x:Key="BorderBrush" Color="#FF1C2733" />
  <SolidColorBrush x:Key="StrongBorderBrush" Color="#FF33445A" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#FF26354A" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF18222E" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FF202D3B" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF1F2C3B" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF8FC4F0" />

  <SolidColorBrush x:Key="PrimaryBrush" Color="#FFE8EEF5" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF0B1016" />

  <!-- ===== Controles ===== -->
  <SolidColorBrush x:Key="ButtonFaceBrush" Color="#FF141C25" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF2A3A4E" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF1B2633" />
  <SolidColorBrush x:Key="InputBrush" Color="#FF141C25" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="#FF243245" />
  <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#FF0B1016" />
  <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#FF8A9BB0" />
  <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FF1C2733" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF2A3A4E" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF5A6E88" />

  <!-- ===== Semanticos ===== -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FFE5484D" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF46A758" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFF5A524" />

</ResourceDictionary>
