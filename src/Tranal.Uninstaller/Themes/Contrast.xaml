<!--
  Tema de alto contraste do Tranal Uninstaller Pro.

  Preto e branco com contorno forte, para leitura em tela com pouca luz. As
  cores sao as mesmas da paleta "Contrast" de Core/Appearance/ThemePalette.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Superficies ===== -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="DescriptionBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="ToolBarBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="StatusBarBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="GroupHeaderBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#FF101010" />

  <!-- ===== Texto ===== -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#FFD0D0D0" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FF909090" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FFFFFF00" />

  <!-- ===== Contorno e interacao ===== -->
  <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF202020" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FF303030" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF0000AA" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF00" />

  <!-- ===== Controles ===== -->
  <SolidColorBrush x:Key="ButtonFaceBrush" Color="#FF202020" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF303030" />
  <SolidColorBrush x:Key="InputBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#FF101010" />
  <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FFFFFFFF" />

  <!-- ===== Semanticos ===== -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5555" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF55FF55" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFFFFF55" />

</ResourceDictionary>
