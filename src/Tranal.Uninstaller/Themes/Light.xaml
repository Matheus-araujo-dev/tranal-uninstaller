<!--
  Cores do tema claro do Tranal Uninstaller Pro.

  O espelho do tema escuro (a paleta do Tranal Sentinel): branco, cartoes um
  tom abaixo do fundo, tinta quase preta e cinza para o secundario. Mesmas
  chaves do tema escuro — o teste do projeto confere.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Superficies ===== -->
  <SolidColorBrush x:Key="SidebarBrush" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="DescriptionBrush" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="ToolBarBrush" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="StatusBarBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="GroupHeaderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RowAlternateBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFF6F6F6" />

  <!-- ===== Texto ===== -->
  <SolidColorBrush x:Key="TextBrush" Color="#FF111111" />
  <SolidColorBrush x:Key="TitleTextBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#FF6B6B6B" />
  <SolidColorBrush x:Key="FaintTextBrush" Color="#FF9A9A9A" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FFB4B4B4" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FF2B2B2B" />

  <!-- ===== Contorno e interacao ===== -->
  <SolidColorBrush x:Key="BorderBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="StrongBorderBrush" Color="#FFC4C4C4" />
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#FFDADADA" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FFEFEFEF" />
  <SolidColorBrush x:Key="PressedBrush" Color="#FFE4E4E4" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF111111" />

  <SolidColorBrush x:Key="PrimaryBrush" Color="#FF111111" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />

  <!-- ===== Controles ===== -->
  <SolidColorBrush x:Key="ButtonFaceBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFD6D6D6" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF2F2F2" />
  <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="#FFDADADA" />
  <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#FF6B6B6B" />
  <SolidColorBrush x:Key="ColumnHeaderBorderBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFD0D0D0" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF9A9A9A" />

  <!-- ===== Semanticos ===== -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FFC62828" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF2E7D32" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB26A00" />

</ResourceDictionary>
