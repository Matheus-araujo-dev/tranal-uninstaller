<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tranal.Uninstaller</RootNamespace>
    <!-- NU1510: o pacote do Event Log vem implicito; a referencia explicita
         e o que garante a compilacao do tipo EventRecord. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <AssemblyName>TranalUninstaller</AssemblyName>
    <ApplicationIcon>Assets\Tranal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Company>Tranal</Company>
    <Product>Tranal Uninstaller</Product>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Catalogos de idioma embarcados (Lang/pt-BR.json, Lang/en-US.json...). -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!--
    O Crash Analyzer le o Windows Event Log (System.Diagnostics.Eventing.Reader).
    O pacote vem implicito no .NET 10 (aviso NU1510, suprimido aqui porque a
    referencia explicita e o que garante a compilacao do tipo EventRecord).
  -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <!-- Mesma razao da CLI: os testes acessam alguns membros internos do nucleo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tranal.Tests" />
  </ItemGroup>
</Project>
