<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tranal.Uninstaller</RootNamespace>
    <AssemblyName>TranalUninstaller</AssemblyName>
    <ApplicationIcon>Assets\Tranal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Company>Tranal</Company>
    <Product>Tranal Uninstaller</Product>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Catalogos de idioma embarcados (Lang/pt-BR.json, Lang/en-US.json...). -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!-- Mesma razao da CLI: os testes acessam alguns membros internos do nucleo. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tranal.Tests" />
  </ItemGroup>
</Project>
