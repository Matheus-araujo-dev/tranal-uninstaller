<Window x:Class="Tranal.Uninstaller.Ui.ForcedUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Desinstalacao forcada" Height="420" Width="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" ShowInTaskbar="False">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="{loc:Tr Forced.Description}" />

    <Grid Grid.Row="1" Margin="0,10,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PathBox" Grid.Column="0" VerticalContentAlignment="Center"
               AutomationProperties.AutomationId="ForcedPathBox" />
      <Button Grid.Column="1" Margin="6,0,0,0" Content="..." Style="{StaticResource FlatButton}"
              Width="34" Click="BrowseButton_Click" AutomationProperties.AutomationId="ForcedBrowseButton" />
    </Grid>

    <ListView x:Name="LeftoversList" Grid.Row="2" BorderThickness="0"
              Background="{DynamicResource PanelBrush}" AlternationCount="2"
              AutomationProperties.AutomationId="ForcedLeftoversList">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="" Width="34">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Tipo" Width="90" DisplayMemberBinding="{Binding Kind}" />
          <GridViewColumn Header="Caminho" Width="430" DisplayMemberBinding="{Binding Path}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}"
               AutomationProperties.AutomationId="ForcedStatusText" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="RemoveButton" Content="{loc:Tr Forced.Remove}" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" IsEnabled="False" Click="RemoveButton_Click"
              AutomationProperties.AutomationId="ForcedRemoveButton" />
      <Button Content="{loc:Tr Forced.Analyze}" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
              IsDefault="True" Click="AnalyzeButton_Click"
              AutomationProperties.AutomationId="ForcedAnalyzeButton" />
      <Button Content="{loc:Tr Common.Close}" Style="{StaticResource FlatButton}" Click="CloseButton_Click"
              AutomationProperties.AutomationId="ForcedCloseButton" />
    </StackPanel>
  </Grid>
</Window>
