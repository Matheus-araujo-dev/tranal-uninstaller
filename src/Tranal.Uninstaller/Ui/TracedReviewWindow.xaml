<Window x:Class="Tranal.Uninstaller.Ui.TracedReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisão"
        Width="1080" Height="660" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- cabecalho -->
            <RowDefinition Height="Auto" />   <!-- barra de comandos -->
            <RowDefinition Height="*" />      <!-- lista -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!-- Cabecalho: qual revisao esta aberta e o que ela vai fazer. -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="TracedReviewTitle"
                       Foreground="{DynamicResource TitleTextBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TracedReviewSubtitle"
                       Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>

        <!-- Barra de comandos da revisao. -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="SelectAllButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedReviewSelectAll"
                    Click="SelectAllButton_Click" />
            <Button x:Name="KeepAllButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedReviewKeepAll"
                    Click="KeepAllButton_Click" />
            <Button x:Name="RemoveButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedReviewRemove"
                    Click="RemoveButton_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedReviewClose"
                    Click="CloseButton_Click" />
        </WrapPanel>

        <!-- A lista que o usuario revisa. -->
        <ListView x:Name="ItemsView" Grid.Row="2" Margin="0,8,0,0" SelectionMode="Extended"
                  BorderBrush="{DynamicResource BorderBrush}"
                  AutomationProperties.AutomationId="TracedReviewItems">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding Tipo}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="{Binding Caminho}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Margin="6,0,0,0" Text="{Binding Decisao}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Margin="6,0,0,0" Text="{Binding Motivo}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextDimBrush}"
                       AutomationProperties.AutomationId="TracedReviewStatus"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
