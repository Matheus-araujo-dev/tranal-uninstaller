<Window x:Class="Tranal.Uninstaller.Ui.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Opcoes" Height="660" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <TextBlock Text="{loc:Tr Options.Theme}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ThemeCombo" Margin="0,0,0,12" AutomationProperties.AutomationId="OptThemeCombo" />

        <!-- As cores personalizadas. A lista de papeis vem do nucleo
             (Core/Appearance/ThemePalette.cs): o que o usuario pode mudar e
             o que a tela usa, e as duas coisas nao se separam. -->
        <TextBlock x:Name="CustomColorsTitleText" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ItemsControl x:Name="CustomColorsPanel" Margin="0,0,0,12"
                      AutomationProperties.AutomationId="OptCustomColors">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Label}" />
                <Border Grid.Column="1" Width="20" Height="20" Margin="6,0,6,0"
                        VerticalAlignment="Center" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{Binding Brush}" />
                <TextBox Grid.Column="2" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="{Binding BoxId}"
                         Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{loc:Tr Options.Language}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,12"
                  AutomationProperties.AutomationId="OptLanguageCombo" />

        <TextBlock Text="{loc:Tr Options.Behavior}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <CheckBox x:Name="DisableTextAnimationsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.DisableTextAnimations}"
                  AutomationProperties.AutomationId="OptDisableTextAnimations" />
        <CheckBox x:Name="ShowSplashScreenCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowSplashScreen}"
                  AutomationProperties.AutomationId="OptShowSplashScreen" />
        <CheckBox x:Name="KeepPreferencesCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.KeepPreferencesOnUninstall}"
                  AutomationProperties.AutomationId="OptKeepPreferences" />
        <CheckBox x:Name="FocusTracedProgramsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.FocusTracedProgramsOnStartup}"
                  AutomationProperties.AutomationId="OptFocusTracedPrograms" />
        <CheckBox x:Name="ShowCheckBoxesCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowCheckBoxesInDetailsView}"
                  AutomationProperties.AutomationId="OptShowCheckBoxes" />
        <CheckBox x:Name="SystemComponentsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Cmd.ShowSystemComponents}"
                  AutomationProperties.AutomationId="OptSystemComponents" />
        <CheckBox x:Name="WindowsAppsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Cmd.ShowWindowsApps}"
                  AutomationProperties.AutomationId="OptWindowsApps" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="{loc:Tr Options.NewProgramsDays}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="NewDaysBox" Width="60" VerticalContentAlignment="Center"
                   AutomationProperties.AutomationId="OptNewProgramsDays" />
        </StackPanel>
        <CheckBox x:Name="ShowWebShortcutsCheck" Margin="0,8,0,2"
                  Content="{loc:Tr Options.ShowWebShortcuts}"
                  AutomationProperties.AutomationId="OptShowWebShortcuts" />
        <CheckBox x:Name="AdvancedModeCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.AdvancedMode}"
                  AutomationProperties.AutomationId="OptAdvancedMode" />
        <CheckBox x:Name="FastLoadingCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.FastLoading}"
                  AutomationProperties.AutomationId="OptFastLoading" />
        <CheckBox x:Name="CheckUpdateCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.CheckUpdate}"
                  AutomationProperties.AutomationId="OptCheckUpdate" />
        <CheckBox x:Name="AutoUpdateCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.AutoUpdate}"
                  AutomationProperties.AutomationId="OptAutoUpdate" />
        <CheckBox x:Name="SkipInformationCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.SkipInformation}"
                  AutomationProperties.AutomationId="OptSkipInformation" />
        <CheckBox x:Name="SkipWarningCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.SkipWarning}"
                  AutomationProperties.AutomationId="OptSkipWarning" />
        <CheckBox x:Name="ShowContextMenuCommandsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowContextMenuCommands}"
                  AutomationProperties.AutomationId="OptShowContextMenuCommands" />
        <CheckBox x:Name="DeleteTracedLogCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.DeleteTracedLog}"
                  AutomationProperties.AutomationId="OptDeleteTracedLog" />

        <!-- Layout: visibilidade dos paineis da janela principal -->
        <TextBlock x:Name="LayoutSectionText" FontWeight="SemiBold" Margin="0,16,0,4" />
        <CheckBox x:Name="ShowMainToolbarCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowMainToolbar}"
                  AutomationProperties.AutomationId="OptShowMainToolbar" />
        <CheckBox x:Name="ShowDescriptionPanelCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowDescriptionPanel}"
                  AutomationProperties.AutomationId="OptShowDescriptionPanel" />
        <CheckBox x:Name="ShowStatusBarCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowStatusBar}"
                  AutomationProperties.AutomationId="OptShowStatusBar" />
        <CheckBox x:Name="ShowToolsToolbarCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowToolsToolbar}"
                  AutomationProperties.AutomationId="OptShowToolsToolbar" />

        <!-- Preferencias de desinstalacao -->
        <TextBlock x:Name="UninstallSectionText" FontWeight="SemiBold" Margin="0,16,0,4" />
        <CheckBox x:Name="CreateRestorePointCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.CreateRestorePoint}"
                  AutomationProperties.AutomationId="OptCreateRestorePoint" />
        <CheckBox x:Name="OnlyBuiltInCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.OnlyBuiltIn}"
                  AutomationProperties.AutomationId="OptOnlyBuiltIn" />
        <CheckBox x:Name="DisableHistoryCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.DisableHistory}"
                  AutomationProperties.AutomationId="OptDisableHistory" />
        <CheckBox x:Name="RecycleBinCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.RecycleBin}"
                  AutomationProperties.AutomationId="OptRecycleBin" />
        <CheckBox x:Name="DeferRemovalCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.DeferRemoval}"
                  AutomationProperties.AutomationId="OptDeferRemoval" />
        <CheckBox x:Name="BackupBeforeRemovalCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.BackupBeforeRemoval}"
                  AutomationProperties.AutomationId="OptBackupBeforeRemoval" />
        <CheckBox x:Name="CheckAllLeftoversCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.CheckAllLeftovers}"
                  AutomationProperties.AutomationId="OptCheckAllLeftovers" />
        <CheckBox x:Name="ForciblyStopExecutablesCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ForciblyStopRunningExecutables}"
                  AutomationProperties.AutomationId="OptForciblyStopExecutables" />
        <CheckBox x:Name="ShowScanAllAccountsCheck" Margin="0,2,0,2"
                  Content="{loc:Tr Options.ShowScanAllAccountsOption}"
                  AutomationProperties.AutomationId="OptShowScanAllAccounts" />

        <!-- Armazenamento -->
        <TextBlock x:Name="StorageSectionText" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBlock Text="{loc:Tr Options.PortableFolder}" Margin="0,0,0,4" />
        <TextBox x:Name="PortableFolderBox" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="OptPortableFolder" />
        <TextBlock Text="{loc:Tr Options.WebSearch}" Margin="0,0,0,4" />
        <TextBox x:Name="WebSearchBox" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="OptWebSearch" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:Tr Common.Cancel}" Style="{StaticResource FlatButton}" Width="90"
              Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True"
              AutomationProperties.AutomationId="OptCancel" />
      <Button Content="{loc:Tr Common.Ok}" Style="{StaticResource FlatButton}" Width="90"
              Click="OkButton_Click" IsDefault="True"
              AutomationProperties.AutomationId="OptOk" />
    </StackPanel>
  </Grid>
</Window>
