<Window x:Class="Tranal.Uninstaller.Ui.UninstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Assistente" Height="620" Width="820" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" ShowInTaskbar="False">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- cabecalho: passos -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="3" Padding="10,8">
      <StackPanel>
        <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="WizardTitle" FontWeight="Bold"
                   Foreground="{DynamicResource TitleTextBrush}" FontSize="14" />
        <TextBlock x:Name="SubtitleText" AutomationProperties.AutomationId="WizardSubtitle"
                   Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- indicador de etapas -->
    <ItemsControl x:Name="StepsBar" Grid.Row="1" Margin="0,10,0,6">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,4,0" Padding="6,4" Background="{DynamicResource DescriptionBrush}" CornerRadius="2">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11" HorizontalAlignment="Center" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- conteudo -->
    <Border Grid.Row="2" Background="{DynamicResource DescriptionBrush}" CornerRadius="3" Padding="12">
      <Grid>
        <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="WizardMessage" TextWrapping="Wrap" VerticalAlignment="Top" />

        <StackPanel x:Name="OptionsPanel" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed">
          <TextBlock Text="{loc:Tr Wizard.Step3.Level}" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SafeRadio" AutomationProperties.AutomationId="ScanSafeRadio"
                         Content="{loc:Tr Wizard.Step3.Safe}" IsChecked="True" Margin="0,0,14,0" />
            <RadioButton x:Name="ModerateRadio" AutomationProperties.AutomationId="ScanModerateRadio"
                         Content="{loc:Tr Wizard.Step3.Moderate}" Margin="0,0,14,0" />
            <RadioButton x:Name="AdvancedRadio" AutomationProperties.AutomationId="ScanAdvancedRadio"
                         Content="{loc:Tr Wizard.Step3.Advanced}" />
          </StackPanel>
          <CheckBox x:Name="AutoDeleteCheck" AutomationProperties.AutomationId="AutoDeleteCheck"
                    Content="{loc:Tr Wizard.Step4.AutoDelete}" Margin="0,10,0,0" />
          <CheckBox x:Name="BackupRegistryCheck" AutomationProperties.AutomationId="BackupRegistryCheck"
                    Content="{loc:Tr Wizard.Step2.Backup}" IsChecked="True" Margin="0,4,0,0" />
          <CheckBox x:Name="RestorePointCheck" AutomationProperties.AutomationId="RestorePointCheck"
                    Content="{loc:Tr Wizard.Step2.RestorePoint}" IsChecked="True" Margin="0,4,0,0" />
        </StackPanel>

        <ListView x:Name="LeftoversList" AutomationProperties.AutomationId="LeftoversList" Margin="0,10,0,0" Visibility="Collapsed"
                  Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="" Width="34">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Tipo" Width="90" DisplayMemberBinding="{Binding Kind}" />
              <GridViewColumn Header="Caminho" Width="520" DisplayMemberBinding="{Binding Path}" />
              <GridViewColumn Header="Tamanho" Width="90" DisplayMemberBinding="{Binding Detail}" />
            </GridView>
          </ListView.View>
        </ListView>

        <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="WizardSummary" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Top" />
      </Grid>
    </Border>

    <!-- rodape -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                 AutomationProperties.AutomationId="WizardStatus"
                 Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="BackButton" Content="{loc:Tr Wizard.Back}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardBackButton"
              Margin="0,0,6,0" Click="BackButton_Click" />
      <Button Grid.Column="2" x:Name="NextButton" Content="{loc:Tr Wizard.Next}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardNextButton"
              Margin="0,0,6,0" Click="NextButton_Click" />
      <Button Grid.Column="3" Content="{loc:Tr Wizard.Cancel}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardCancelButton"
              Click="CancelButton_Click" />
    </Grid>
  </Grid>
</Window>
