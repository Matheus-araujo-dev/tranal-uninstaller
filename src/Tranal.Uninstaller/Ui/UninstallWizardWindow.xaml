<Window x:Class="Tranal.Uninstaller.Ui.UninstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Assistente" Height="680" Width="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" ShowInTaskbar="False">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- cabecalho: passos -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="3" Padding="10,8">
      <StackPanel>
        <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="WizardTitle" FontWeight="Bold"
                   Foreground="{DynamicResource TitleTextBrush}" FontSize="14" />
        <TextBlock x:Name="SubtitleText" AutomationProperties.AutomationId="WizardSubtitle"
                   Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- indicador de etapas -->
    <ItemsControl x:Name="StepsBar" Grid.Row="1" Margin="0,10,0,6">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,4,0" Padding="6,4" Background="{DynamicResource DescriptionBrush}" CornerRadius="2">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" FontSize="11" HorizontalAlignment="Center" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- conteudo -->
    <Border Grid.Row="2" Background="{DynamicResource DescriptionBrush}" CornerRadius="3" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" AutomationProperties.AutomationId="WizardMessage"
                   TextWrapping="Wrap" VerticalAlignment="Top" />

        <!-- Etapa 1: escolha do modo de desinstalacao (a unica opcao da operacao) -->
        <StackPanel x:Name="ModePanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBlock Text="{loc:Tr Wizard.Mode.Title}" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Tr Wizard.Mode.Intro}" TextWrapping="Wrap" Margin="0,2,0,8"
                     Foreground="{DynamicResource TextDimBrush}" />

          <RadioButton x:Name="ModeBuiltInRadio" GroupName="UninstallMode" Margin="0,0,0,2"
                       Content="{loc:Tr Wizard.Mode.BuiltIn}"
                       AutomationProperties.AutomationId="ModeBuiltInRadio" />
          <TextBlock Text="{loc:Tr Wizard.Mode.BuiltInDesc}" Margin="22,0,0,6" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextDimBrush}" />

          <RadioButton x:Name="ModeSafeRadio" GroupName="UninstallMode" Margin="0,0,0,2"
                       Content="{loc:Tr Wizard.Mode.Safe}"
                       AutomationProperties.AutomationId="ModeSafeRadio" />
          <TextBlock Text="{loc:Tr Wizard.Mode.SafeDesc}" Margin="22,0,0,6" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextDimBrush}" />

          <RadioButton x:Name="ModeModerateRadio" GroupName="UninstallMode" Margin="0,0,0,2"
                       Content="{loc:Tr Wizard.Mode.Moderate}"
                       AutomationProperties.AutomationId="ModeModerateRadio" />
          <TextBlock Text="{loc:Tr Wizard.Mode.ModerateDesc}" Margin="22,0,0,6" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextDimBrush}" />

          <RadioButton x:Name="ModeAdvancedRadio" GroupName="UninstallMode" Margin="0,0,0,2"
                       Content="{loc:Tr Wizard.Mode.Advanced}"
                       AutomationProperties.AutomationId="ModeAdvancedRadio" />
          <TextBlock Text="{loc:Tr Wizard.Mode.AdvancedDesc}" Margin="22,0,0,6" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>

        <!-- Etapa 2: opcoes da execucao nativa -->
        <StackPanel x:Name="OptionsPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
          <CheckBox x:Name="BackupRegistryCheck" AutomationProperties.AutomationId="BackupRegistryCheck"
                    Content="{loc:Tr Wizard.Step2.Backup}" IsChecked="True" Margin="0,0,0,4" />
          <CheckBox x:Name="RestorePointCheck" AutomationProperties.AutomationId="RestorePointCheck"
                    Content="{loc:Tr Wizard.Step2.RestorePoint}" Margin="0,0,0,4" />
          <TextBlock x:Name="RestorePointNote" AutomationProperties.AutomationId="RestorePointNote"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="22,0,0,0"
                     Visibility="Collapsed" />
          <CheckBox x:Name="FullRegistryBackupCheck" AutomationProperties.AutomationId="FullRegistryBackupCheck"
                    Content="{loc:Tr Wizard.FullRegistryBackupCheck}" Margin="0,0,0,4" />
          <CheckBox x:Name="SilentUninstallCheck" AutomationProperties.AutomationId="SilentUninstallCheck"
                    Content="{loc:Tr Wizard.Step2.Silent}" Margin="0,0,0,4" />
          <CheckBox x:Name="ScanAllAccountsCheck" AutomationProperties.AutomationId="ScanAllAccountsCheck"
                    Content="{loc:Tr Wizard.ScanAllAccountsCheck}" Margin="0,0,0,4" Visibility="Collapsed" />
          <CheckBox x:Name="UninstallAllAccountsCheck" AutomationProperties.AutomationId="UninstallAllAccountsCheck"
                    Content="{loc:Tr Wizard.UninstallAllAccountsCheck}" Margin="0,0,0,4" Visibility="Collapsed" />
          <TextBlock x:Name="ScanAllAccountsNote" AutomationProperties.AutomationId="ScanAllAccountsNote"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="22,0,0,0"
                     Visibility="Collapsed" />
        </StackPanel>

        <!-- Etapa 3: modo em uso -->
        <TextBlock x:Name="ModeInfoText" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"
                   FontWeight="SemiBold" AutomationProperties.AutomationId="WizardModeInfo" />

        <!-- Etapa 4: remocao das sobras -->
        <Grid x:Name="RemovalPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{loc:Tr Wizard.Step4.Legend}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />

          <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button x:Name="SelectAllButton" Content="{loc:Tr Wizard.Step4.SelectAll}" Style="{StaticResource FlatButton}"
                    AutomationProperties.AutomationId="WizardSelectAllButton" Margin="0,0,6,0"
                    Click="SelectAllButton_Click" />
            <Button x:Name="DeselectAllButton" Content="{loc:Tr Wizard.Step4.DeselectAll}" Style="{StaticResource FlatButton}"
                    AutomationProperties.AutomationId="WizardDeselectAllButton" Margin="0,0,12,0"
                    Click="DeselectAllButton_Click" />
            <TextBlock Text="{loc:Tr Wizard.Step4.RecycleBin}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextDimBrush}" />
          </WrapPanel>

          <ListView x:Name="LeftoversList" Grid.Row="2" AutomationProperties.AutomationId="LeftoversList"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    AlternationCount="2" />
        </Grid>

        <!-- Etapa 5: resumo -->
        <TextBlock x:Name="SummaryText" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" TextWrapping="Wrap"
                   VerticalAlignment="Top" AutomationProperties.AutomationId="WizardSummary" />
      </Grid>
    </Border>

    <!-- rodape -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                 AutomationProperties.AutomationId="WizardStatus"
                 Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="BackButton" Content="{loc:Tr Wizard.Back}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardBackButton"
              Margin="0,0,6,0" Click="BackButton_Click" />
      <Button Grid.Column="2" x:Name="NextButton" Content="{loc:Tr Wizard.Next}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardNextButton"
              Margin="0,0,6,0" Click="NextButton_Click" />
      <Button Grid.Column="3" Content="{loc:Tr Wizard.Cancel}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="WizardCancelButton"
              Click="CancelButton_Click" />
    </Grid>
  </Grid>
</Window>
