<Window x:Class="Tranal.Uninstaller.Ui.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Renomear" Height="200" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" UseLayoutRounding="True">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,6" />

    <TextBox Grid.Row="1" x:Name="NameBox"
             AutomationProperties.AutomationId="RenameBox" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="{loc:Tr Common.Ok}" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" AutomationProperties.AutomationId="RenameOk"
              Click="OkButton_Click" />
      <Button x:Name="CancelButton" Content="{loc:Tr Common.Cancel}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="RenameCancel"
              Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
