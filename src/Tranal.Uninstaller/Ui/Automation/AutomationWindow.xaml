<Window x:Class="Tranal.Uninstaller.Ui.Automation.AutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automacao da desinstalacao" Height="470" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" ShowInTaskbar="False">

  <!--
    A superficie do painel de progresso. O modelo (etapa atual, item atual,
    total e os comandos do usuario) mora no nucleo
    (Core/Automation/RemovalProgress.cs); esta janela apenas mostra e
    traduz o que o usuario mandou em "pular", "encerrar" e "rodar agora".
  -->
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="ProgramText" TextWrapping="Wrap" FontWeight="SemiBold" />

    <Grid Grid.Row="1" Margin="0,10,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Grid.Column="0" x:Name="ProgressTrack" Minimum="0" Maximum="1"
                   Height="14" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Margin="8,0,0,0" x:Name="ProgressText"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" />
    </Grid>

    <ListView Grid.Row="2" x:Name="StepsList" BorderThickness="0"
              Background="{DynamicResource PanelBrush}"
              AutomationProperties.AutomationId="AutomationStepsList">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Etapa" Width="470" DisplayMemberBinding="{Binding Descricao}" />
          <GridViewColumn Header="Situacao" Width="140" DisplayMemberBinding="{Binding Situacao}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock Grid.Row="3" Margin="0,8,0,0" x:Name="StatusText" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}"
               AutomationProperties.AutomationId="AutomationStatusText" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="SkipButton" Content="Pular" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" Click="SkipButton_Click"
              AutomationProperties.AutomationId="AutomationSkipButton" />
      <Button x:Name="StopButton" Content="Encerrar" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" Click="StopButton_Click"
              AutomationProperties.AutomationId="AutomationStopButton" />
      <Button x:Name="RunNowButton" Content="Rodar agora" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" Click="RunNowButton_Click"
              AutomationProperties.AutomationId="AutomationRunNowButton" />
      <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource FlatButton}"
              Click="CloseButton_Click"
              AutomationProperties.AutomationId="AutomationCloseButton" />
    </StackPanel>
  </Grid>
</Window>
