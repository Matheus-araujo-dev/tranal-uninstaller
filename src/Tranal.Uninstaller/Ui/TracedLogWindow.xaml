<Window x:Class="Tranal.Uninstaller.Ui.TracedLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log"
        Width="1180" Height="700" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- cabecalho -->
            <RowDefinition Height="Auto" />   <!-- barra de comandos -->
            <RowDefinition Height="Auto" />   <!-- painel de edicao da entrada -->
            <RowDefinition Height="*" />      <!-- listas -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!-- Cabecalho: qual log esta aberto e quantas entradas ele tem. -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="TracedLogTitle"
                       Foreground="{DynamicResource TitleTextBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TracedLogSubtitle"
                       Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>

        <!-- Barra de comandos da janela. -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="EditButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogEdit"
                    Click="EditButton_Click" />
            <Button x:Name="IgnoreButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogIgnore"
                    Click="IgnoreButton_Click" />
            <Button x:Name="RestoreButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogRestore"
                    Click="RestoreButton_Click" />
            <Button x:Name="RemoveEntryButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogRemoveEntry"
                    Click="RemoveEntryButton_Click" />
            <Button x:Name="AddEntryButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogAddEntry"
                    Click="AddEntryButton_Click" />
            <Button x:Name="RenameButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogRename"
                    Click="RenameButton_Click" />
            <Button x:Name="ExportButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogExport"
                    Click="ExportButton_Click" />
            <Button x:Name="MergeButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogMerge"
                    Click="MergeButton_Click" />
            <Button x:Name="CustomButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogCustom"
                    Click="CustomButton_Click" />
            <Button x:Name="AdvancedButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogAdvanced"
                    Click="AdvancedButton_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TracedLogClose"
                    Click="CloseButton_Click" />
        </WrapPanel>

        <!-- Painel de edicao da entrada: os mesmos campos que a entrada tem. -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="EditTitleText" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="TracedLogEditTitle"
                           Foreground="{DynamicResource TitleTextBrush}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="KindLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogKindLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <ComboBox x:Name="KindCombo" Grid.Row="1" Grid.Column="0" MinWidth="150" Margin="0,3,10,0"
                              AutomationProperties.AutomationId="TracedLogKind" />

                    <TextBlock x:Name="PathLabel" Grid.Row="0" Grid.Column="1" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogPathLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" Margin="0,3,10,0"
                             AutomationProperties.AutomationId="TracedLogPath" />

                    <TextBlock x:Name="ValueNameLabel" Grid.Row="0" Grid.Column="2" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogValueNameLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBox x:Name="ValueNameBox" Grid.Row="1" Grid.Column="2" MinWidth="140" Margin="0,3,10,0"
                             AutomationProperties.AutomationId="TracedLogValueName" />

                    <TextBlock x:Name="ValueLabel" Grid.Row="0" Grid.Column="3" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogValueLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBox x:Name="ValueBox" Grid.Row="1" Grid.Column="3" MinWidth="140" Margin="0,3,10,0"
                             AutomationProperties.AutomationId="TracedLogValue" />

                    <TextBlock x:Name="OperationLabel" Grid.Row="0" Grid.Column="4" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogOperationLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <ComboBox x:Name="OperationCombo" Grid.Row="1" Grid.Column="4" MinWidth="130" Margin="0,3,10,0"
                              AutomationProperties.AutomationId="TracedLogOperation" />

                    <TextBlock x:Name="OriginLabel" Grid.Row="0" Grid.Column="5" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogOriginLabel"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock x:Name="OriginText" Grid.Row="1" Grid.Column="5" MinWidth="110"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TracedLogOrigin"
                               Foreground="{DynamicResource TextDimBrush}" />
                </Grid>

                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="SaveEditButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="TracedLogSaveEdit"
                            Click="SaveEditButton_Click" />
                    <Button x:Name="ClearEditButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="TracedLogClearEdit"
                            Click="ClearEditButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Listas: as entradas do log (esquerda) e os logs a mesclar (direita). -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="EntriesView" Grid.Column="0" SelectionMode="Extended"
                      BorderBrush="{DynamicResource BorderBrush}"
                      AutomationProperties.AutomationId="TracedLogEntries" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="MergeTitleText" Grid.Row="0" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="TracedLogMergeTitle"
                           Foreground="{DynamicResource TitleTextBrush}" />
                <TextBlock x:Name="MergeHintText" Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="TracedLogMergeHint"
                           Foreground="{DynamicResource TextDimBrush}" />

                <ListView x:Name="MergeLogsView" Grid.Row="2" Margin="0,4,0,0" SelectionMode="Multiple"
                          BorderBrush="{DynamicResource BorderBrush}"
                          AutomationProperties.AutomationId="TracedLogMergeList">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="2" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextDimBrush}" Text="{Binding Date}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBox x:Name="MergeNameBox" Grid.Row="3" Margin="0,6,0,0"
                         AutomationProperties.AutomationId="TracedLogMergeName" />

                <TextBlock x:Name="MergeNameLabel" Grid.Row="4" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="TracedLogMergeNameLabel"
                           Foreground="{DynamicResource TextDimBrush}" />
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="8,6"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextDimBrush}"
                       AutomationProperties.AutomationId="TracedLogStatus"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
