<Window x:Class="Tranal.Uninstaller.Ui.Reporting.ReportingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imprimir" Height="660" Width="960"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" UseLayoutRounding="True">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- cabecalho do documento -->
      <RowDefinition Height="*" />      <!-- visualizacao -->
      <RowDefinition Height="Auto" />   <!-- botoes -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,8" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="PagesList" AutomationProperties.AutomationId="ReportingPages">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Header}" Margin="0,0,0,8" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontFamily="Consolas,Courier New,monospace"
                                 FontSize="11" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Footer}" HorizontalAlignment="Right" Margin="0,8,0,0" Opacity="0.8" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="PrintButton" Content="Imprimir" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" AutomationProperties.AutomationId="ReportingPrint"
              Click="PrintButton_Click" />
      <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="ReportingClose"
              Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
