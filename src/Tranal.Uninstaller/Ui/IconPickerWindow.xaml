<Window x:Class="Tranal.Uninstaller.Ui.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Escolher ícone" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" UseLayoutRounding="True">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- pergunta -->
      <RowDefinition Height="*" />      <!-- galeria -->
      <RowDefinition Height="Auto" />   <!-- caminho do arquivo -->
      <RowDefinition Height="Auto" />   <!-- botoes -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />

    <ListView Grid.Row="1" x:Name="GalleryList" AutomationProperties.AutomationId="IconGalleryList"
              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
              SelectionMode="Single" SelectionChanged="GalleryList_SelectionChanged">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Image}" Width="24" Height="24" Stretch="Uniform" />
            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="{loc:Tr Icon.FilePath}" Margin="0,0,0,4" />
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="PathBox" Width="380" VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="IconPathBox" />
        <Button x:Name="BrowseButton" Content="{loc:Tr Icon.Browse}" Style="{StaticResource FlatButton}"
                Margin="6,0,0,0" AutomationProperties.AutomationId="IconBrowse"
                Click="BrowseButton_Click" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="{loc:Tr Common.Ok}" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" AutomationProperties.AutomationId="IconOk"
              Click="OkButton_Click" />
      <Button x:Name="CancelButton" Content="{loc:Tr Common.Cancel}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="IconCancel"
              Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
