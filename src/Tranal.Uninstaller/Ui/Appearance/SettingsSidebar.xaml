<UserControl x:Class="Tranal.Uninstaller.Ui.Appearance.SettingsSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
             xmlns:local="clr-namespace:Tranal.Uninstaller.Ui.Appearance"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{DynamicResource UiFont}" FontSize="11"
             UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- cabecalho do painel -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <TextBlock Text="{loc:Tr Sidebar.Settings}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextBrush}" />
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12">

        <!-- ============================================================
             SECAO: FILTROS
             ============================================================ -->
        <TextBlock Text="{loc:Tr Sidebar.Filters}" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TitleTextBrush}" />

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Common.Search}" VerticalAlignment="Center"
                     Margin="0,0,8,6" Foreground="{DynamicResource TextDimBrush}" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchBox" Margin="0,0,0,6"
                   TextChanged="SearchBox_TextChanged" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Sidebar.Filter.Publisher}" VerticalAlignment="Center"
                     Margin="0,0,8,6" Foreground="{DynamicResource TextDimBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PublisherBox" Margin="0,0,0,6"
                   TextChanged="PublisherBox_TextChanged" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Sidebar.FilterByType}" VerticalAlignment="Center"
                     Margin="0,0,8,6" Foreground="{DynamicResource TextDimBrush}" />
          <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TypeCombo" Margin="0,0,0,6"
                    SelectionChanged="TypeCombo_SelectionChanged">
            <ComboBoxItem Content="{loc:Tr Sidebar.All}" Tag="All" />
            <ComboBoxItem Content="{loc:Tr Sidebar.Bits32}" Tag="32" />
            <ComboBoxItem Content="{loc:Tr Sidebar.Bits64}" Tag="64" />
            <ComboBoxItem Content="{loc:Tr Sidebar.Msi}" Tag="msi" />
          </ComboBox>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Sidebar.FilterBySize}" VerticalAlignment="Center"
                     Margin="0,0,8,6" Foreground="{DynamicResource TextDimBrush}" />
          <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SizeCombo" Margin="0,0,0,6"
                    SelectionChanged="SizeCombo_SelectionChanged">
            <ComboBoxItem Content="{loc:Tr Sidebar.All}" Tag="all" />
            <ComboBoxItem Content="{loc:Tr Sidebar.SizeSmall}" Tag="small" />
            <ComboBoxItem Content="{loc:Tr Sidebar.SizeMedium}" Tag="medium" />
            <ComboBoxItem Content="{loc:Tr Sidebar.SizeLarge}" Tag="large" />
          </ComboBox>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Sidebar.FilterByDrive}" VerticalAlignment="Center"
                     Margin="0,0,8,6" Foreground="{DynamicResource TextDimBrush}" />
          <ComboBox Grid.Row="4" Grid.Column="1" x:Name="DriveCombo" Margin="0,0,0,6"
                    SelectionChanged="DriveCombo_SelectionChanged" />
        </Grid>

        <CheckBox x:Name="OnlyCommentsCheck" Content="{loc:Tr Sidebar.Filter.OnlyComments}"
                  Margin="0,4,0,2" Click="OnlyCommentsCheck_Click" />
        <CheckBox x:Name="OnlyGroupsCheck" Content="{loc:Tr Sidebar.Filter.OnlyGroups}"
                  Margin="0,0,0,8" Click="OnlyGroupsCheck_Click" />

        <!-- Exclusoes: termos que saem da lista mesmo que a busca ache.
             A regra mora no ProgramFilterSet (o nucleo); a tela so edita. -->
        <TextBlock Text="{loc:Tr Sidebar.Filter.Exclusions}" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextDimBrush}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Row="0" Grid.Column="0" x:Name="ExclusionBox" Margin="0,0,6,0"
                   AutomationProperties.AutomationId="OptExclusion" />
          <Button Grid.Row="0" Grid.Column="1" x:Name="AddExclusionButton"
                  Content="{loc:Tr Sidebar.Filter.AddExclusion}"
                  Style="{StaticResource FlatButton}" Padding="8,3"
                  AutomationProperties.AutomationId="OptAddExclusion"
                  Click="AddExclusionButton_Click" />
        </Grid>
        <ItemsControl x:Name="ExclusionList" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextDimBrush}" />
                <Button Content="{loc:Tr Sidebar.Filter.RemoveExclusion}"
                        Style="{StaticResource FlatButton}" Padding="4,0" Margin="6,0,0,0"
                        Tag="{Binding}"
                        AutomationProperties.AutomationId="OptRemoveExclusion"
                        Click="RemoveExclusionButton_Click" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- O aviso da regex invalida: a lista continua funcionando, mas o
             usuario precisa saber que o filtro dele nao esta valendo. -->
        <TextBlock x:Name="FilterDiagnosticText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextDimBrush}"
                   AutomationProperties.AutomationId="OptFilterDiagnostic" />

        <Button x:Name="ClearFiltersButton" Content="{loc:Tr Sidebar.Filter.Clear}"
                Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="10,3"
                Margin="0,8,0,0"
                Click="ClearFiltersButton_Click" />

        <!-- ============================================================
             SECAO: REALCES
             ============================================================ -->
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12" />

        <TextBlock Text="{loc:Tr Sidebar.Highlights}" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TitleTextBrush}" />

        <ItemsControl x:Name="HighlightList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource DescriptionBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="6" Margin="0,0,0,6">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                              ToolTip="{loc:Tr Common.Enable}"
                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                              Click="HighlightEnabled_Click" />

                    <TextBox Grid.Column="1" VerticalAlignment="Center"
                             Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="HighlightPattern_TextChanged" />

                    <Button Grid.Column="2" Content="{loc:Tr Common.Remove}"
                            Style="{StaticResource FlatButton}" Padding="8,2" Margin="6,0,0,0"
                            Click="RemoveHighlight_Click" />
                  </Grid>

                  <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Sidebar.Highlight.Scope}"
                               Margin="0,0,0,2" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr Sidebar.Highlight.Color}"
                               Margin="6,0,0,2" Foreground="{DynamicResource TextDimBrush}" />

                    <ComboBox Grid.Row="1" Grid.Column="0" MinWidth="110"
                              ItemsSource="{x:Static local:HighlightOptions.Scopes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Scope, Mode=TwoWay}"
                              SelectionChanged="HighlightScope_Changed" />

                    <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="100" Margin="6,0,0,0"
                              ItemsSource="{x:Static local:HighlightOptions.Colors}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding ColorKey, Mode=TwoWay}"
                              SelectionChanged="HighlightColor_Changed" />

                    <Border Grid.Row="1" Grid.Column="2" x:Name="HighlightSwatch" Width="14" Height="14"
                            Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="2"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Loaded="HighlightSwatch_Loaded" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="AddHighlightButton" Content="{loc:Tr Sidebar.Highlight.Add}"
                Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="10,3"
                Click="AddHighlightButton_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
