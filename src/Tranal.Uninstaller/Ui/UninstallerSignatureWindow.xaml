<Window x:Class="Tranal.Uninstaller.Ui.UninstallerSignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
        Title="Assinatura do desinstalador" Height="460" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
        FontSize="12" UseLayoutRounding="True">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0" x:Name="DetailBox" IsReadOnly="True"
             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="11"
             AutomationProperties.AutomationId="SignatureDetails" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CopyButton" Content="{loc:Tr Signature.Copy}" Style="{StaticResource FlatButton}"
              Margin="0,0,6,0" AutomationProperties.AutomationId="SignatureCopy"
              Click="CopyButton_Click" />
      <Button x:Name="CloseButton" Content="{loc:Tr Common.Close}" Style="{StaticResource FlatButton}"
              AutomationProperties.AutomationId="SignatureClose"
              Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
