<UserControl x:Class="Tranal.Uninstaller.Ui.Management.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
             Background="{DynamicResource PanelBrush}" FontFamily="{DynamicResource UiFont}"
             FontSize="12">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Programa escolhido: e ele que amarra as permissoes e a saude. -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                 Text="{loc:Tr Mgmt.Program}" />
      <ComboBox x:Name="ProgramBox" Grid.Column="1" VerticalContentAlignment="Center"
                AutomationProperties.AutomationId="MgmtProgramBox" />
      <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource FlatButton}"
              Content="{loc:Tr Mgmt.Refresh}" Click="RefreshButton_Click"
              AutomationProperties.AutomationId="MgmtRefreshButton" />
    </Grid>

    <TabControl Grid.Row="1" Background="{DynamicResource PanelBrush}"
                AutomationProperties.AutomationId="MgmtTabs">

      <!-- Permissoes do programa: servico, inicializacao, menu de contexto, tarefa. -->
      <TabItem Header="{loc:Tr Mgmt.TabPermissions}">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView x:Name="PermissionsList" Grid.Row="0" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}" AlternationCount="2"
                    SelectionChanged="PermissionsList_SelectionChanged"
                    AutomationProperties.AutomationId="MgmtPermissionsList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="150" />
                <GridViewColumn Header="" Width="220" />
                <GridViewColumn Header="" Width="420" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="EnableButton" Content="{loc:Tr Mgmt.Enable}" Style="{StaticResource FlatButton}"
                    Margin="0,0,6,0" IsEnabled="False" Click="EnableButton_Click"
                    AutomationProperties.AutomationId="MgmtEnableButton" />
            <Button x:Name="DisableButton" Content="{loc:Tr Mgmt.Disable}" Style="{StaticResource FlatButton}"
                    Margin="0,0,6,0" IsEnabled="False" Click="DisableButton_Click"
                    AutomationProperties.AutomationId="MgmtDisableButton" />
            <Button x:Name="RemovePermissionButton" Content="{loc:Tr Mgmt.Remove}" Style="{StaticResource FlatButton}"
                    IsEnabled="False" Click="RemovePermissionButton_Click"
                    AutomationProperties.AutomationId="MgmtRemovePermissionButton" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Servicos do Windows. -->
      <TabItem Header="{loc:Tr Mgmt.TabServices}">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView x:Name="ServicesList" Grid.Row="0" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}" AlternationCount="2"
                    AutomationProperties.AutomationId="MgmtServicesList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="200" />
                <GridViewColumn Header="" Width="90" />
                <GridViewColumn Header="" Width="90" />
                <GridViewColumn Header="" Width="380" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DisableServiceButton" Content="{loc:Tr Mgmt.Disable}" Style="{StaticResource FlatButton}"
                    Margin="0,0,6,0" IsEnabled="False" Click="DisableServiceButton_Click"
                    AutomationProperties.AutomationId="MgmtDisableServiceButton" />
            <Button x:Name="RemoveServiceButton" Content="{loc:Tr Mgmt.Remove}" Style="{StaticResource FlatButton}"
                    IsEnabled="False" Click="RemoveServiceButton_Click"
                    AutomationProperties.AutomationId="MgmtRemoveServiceButton" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Tarefas agendadas. -->
      <TabItem Header="{loc:Tr Mgmt.TabTasks}">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView x:Name="TasksList" Grid.Row="0" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}" AlternationCount="2"
                    AutomationProperties.AutomationId="MgmtTasksList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="320" />
                <GridViewColumn Header="" Width="90" />
                <GridViewColumn Header="" Width="380" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DisableTaskButton" Content="{loc:Tr Mgmt.Disable}" Style="{StaticResource FlatButton}"
                    Margin="0,0,6,0" IsEnabled="False" Click="DisableTaskButton_Click"
                    AutomationProperties.AutomationId="MgmtDisableTaskButton" />
            <Button x:Name="RemoveTaskButton" Content="{loc:Tr Mgmt.Remove}" Style="{StaticResource FlatButton}"
                    IsEnabled="False" Click="RemoveTaskButton_Click"
                    AutomationProperties.AutomationId="MgmtRemoveTaskButton" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Pacotes de driver. -->
      <TabItem Header="{loc:Tr Mgmt.TabDrivers}">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView x:Name="DriversList" Grid.Row="0" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}" AlternationCount="2"
                    AutomationProperties.AutomationId="MgmtDriversList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="110" />
                <GridViewColumn Header="" Width="200" />
                <GridViewColumn Header="" Width="130" />
                <GridViewColumn Header="" Width="90" />
                <GridViewColumn Header="" Width="230" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RemoveDriverButton" Content="{loc:Tr Mgmt.Remove}" Style="{StaticResource FlatButton}"
                    IsEnabled="False" Click="RemoveDriverButton_Click"
                    AutomationProperties.AutomationId="MgmtRemoveDriverButton" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Saude do software: sobras, arquivos redundantes, permissoes e avisos. -->
      <TabItem Header="{loc:Tr Mgmt.TabHealth}">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView x:Name="HealthList" Grid.Row="0" BorderThickness="0"
                    Background="{DynamicResource PanelBrush}" AlternationCount="2"
                    AutomationProperties.AutomationId="MgmtHealthList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="140" />
                <GridViewColumn Header="" Width="100" />
                <GridViewColumn Header="" Width="320" />
                <GridViewColumn Header="" Width="200" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AnalyzeHealthButton" Content="{loc:Tr Mgmt.Analyze}" Style="{StaticResource FlatButton}"
                    Click="AnalyzeHealthButton_Click"
                    AutomationProperties.AutomationId="MgmtAnalyzeHealthButton" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}"
               AutomationProperties.AutomationId="MgmtStatusText" />
  </Grid>
</UserControl>
