<UserControl x:Class="Tranal.Uninstaller.Ui.Modules.HunterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
             AllowDrop="True" Drop="Target_Drop" DragOver="Target_DragOver"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{DynamicResource UiFont}" FontSize="11"
             UseLayoutRounding="True">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <TextBlock Text="{loc:Tr Module.HunterMode}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextBrush}" />
    </Border>

    <!-- area de arrastar e soltar -->
    <Border x:Name="DropZone" Grid.Row="1" Margin="0,14,0,14" MinHeight="150"
            BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="2" CornerRadius="4"
            Background="{DynamicResource DescriptionBrush}"
            AutomationProperties.AutomationId="HunterDropZone">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="&#x1F3AF;" FontSize="40" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Tr Hunter.Drop}" Margin="0,10,0,0" TextAlignment="Center"
                   Foreground="{DynamicResource TextDimBrush}" />
        <Button x:Name="BrowseButton" Content="{loc:Tr Common.Open}" Style="{StaticResource FlatButton}"
                Margin="0,12,0,0" HorizontalAlignment="Center" Click="BrowseButton_Click"
                AutomationProperties.AutomationId="HunterBrowseButton" />
      </StackPanel>
    </Border>

    <!-- resultado da resolucao -->
    <Border Grid.Row="2" Background="{DynamicResource DescriptionBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
      <StackPanel>
        <TextBlock Text="{loc:Tr Hunter.Resolved}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                   AutomationProperties.AutomationId="HunterResultText" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="UninstallButton" Content="{loc:Tr Hunter.Start}" Style="{StaticResource FlatButton}"
              IsEnabled="False" Click="UninstallButton_Click"
              AutomationProperties.AutomationId="HunterUninstallButton" />
    </StackPanel>
  </Grid>
</UserControl>
