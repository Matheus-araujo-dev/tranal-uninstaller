<UserControl x:Class="Tranal.Uninstaller.Ui.Shared.ItemListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{DynamicResource UiFont}" FontSize="11"
             UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- titulo -->
      <RowDefinition Height="Auto" />   <!-- barra de comandos -->
      <RowDefinition Height="*" />      <!-- lista -->
      <RowDefinition Height="Auto" />   <!-- status -->
    </Grid.RowDefinitions>

    <!-- Titulo do painel -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <TextBlock x:Name="TitleText" Text="" FontWeight="SemiBold"
                 Foreground="{DynamicResource TitleTextBrush}" />
    </Border>

    <!-- Barra de comandos da ferramenta/modulo ativo -->
    <Border Grid.Row="1" Background="{DynamicResource DescriptionBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
      <ItemsControl x:Name="CommandBar">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <!-- Lista -->
    <ListView x:Name="ItemsList" Grid.Row="2" BorderThickness="0"
              Background="{DynamicResource PanelBrush}" AlternationCount="2"
              SelectionMode="Extended" />

    <!-- Status -->
    <Border Grid.Row="3" Background="{DynamicResource StatusBarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="PanelStatusText" Margin="8,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
