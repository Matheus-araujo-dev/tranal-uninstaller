<UserControl x:Class="Tranal.Uninstaller.Ui.Shared.LeftoversTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Tranal.Uninstaller.Ui"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{DynamicResource UiFont}" FontSize="11">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- busca e comando -->
      <RowDefinition Height="*" />      <!-- arvore -->
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" VerticalContentAlignment="Center"
               AutomationProperties.AutomationId="LeftoversSearchBox"
               ToolTip="{loc:Tr Wizard.Step4.Search}"
               TextChanged="SearchBox_TextChanged" />
      <Button x:Name="BrowseButton" Grid.Column="1" Margin="6,0,0,0"
              Style="{StaticResource FlatButton}" Content="{loc:Tr Wizard.Step4.Browse}"
              Click="BrowseButton_Click" IsEnabled="False"
              AutomationProperties.AutomationId="LeftoversBrowseButton" />
    </Grid>

    <TreeView x:Name="Tree" Grid.Row="1" BorderThickness="0"
              Background="{DynamicResource PanelBrush}"
              AutomationProperties.AutomationId="LeftoversTree"
              SelectedItemChanged="Tree_SelectedItemChanged" />
  </Grid>
</UserControl>
