<Window x:Class="Tranal.Uninstaller.Ui.Tracing.TraceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador do log"
        Width="960" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="TraceManagerTitle"
                       Foreground="{DynamicResource TitleTextBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TraceManagerSubtitle"
                       Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="ItemsView" Margin="0,8,0,0"
                  AutomationProperties.AutomationId="TraceManagerItems">
            <ListView.View>
                <GridView />
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" x:Name="KindCombo" Width="170" Margin="0,0,6,0"
                      AutomationProperties.AutomationId="TraceManagerKind" />

            <TextBox Grid.Column="1" x:Name="PathBox" Margin="0,0,6,0"
                     AutomationProperties.AutomationId="TraceManagerPath" />

            <Button Grid.Column="2" x:Name="AddButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TraceManagerAdd"
                    Click="AddButton_Click" />

            <Button Grid.Column="3" x:Name="RemoveButton" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                    AutomationProperties.AutomationId="TraceManagerRemove"
                    Click="RemoveButton_Click" />

            <Button Grid.Column="4" x:Name="CloseButton" Style="{StaticResource FlatButton}"
                    AutomationProperties.AutomationId="TraceManagerClose"
                    Click="CloseButton_Click" />
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="TraceManagerStatus"
                   Foreground="{DynamicResource TextDimBrush}" />
    </Grid>
</Window>
