<Application x:Class="Tranal.Uninstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- O tema unico e carregado aqui, uma unica vez, por caminho
           relativo (XAML). A troca em runtime escreve as brushes em
           Application.Resources, que e o caminho que o WPF notifica.
           O catalogo de temas vive em Core/Appearance/ThemePalette.cs. -->
      <ResourceDictionary x:Key="ThemeCatalog">
        <ResourceDictionary x:Key="Dark" Source="Themes/Dark.xaml" />
      </ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <!-- Estilos comuns aos dois temas. -->
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
